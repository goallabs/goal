{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "goal.js",
  "scopeName": "source.goal",
  "comment": "goal.js is JavaScript + JSX, highlighted with VS Code's built-in TypeScript React grammar (source.tsx) so that the types in #strict files highlight too, with goal's additions: `#strict` on the first line, `route METHOD /path/{param} { }` at the top level, `server function`, and `{if (a) X else if (b) Y else Z}` in markup. The route, server function and {if} are injections, so the TSX grammar does everything else.",
  "patterns": [
    {
      "include": "#strict"
    },
    {
      "include": "source.tsx"
    }
  ],
  "injections": {
    "L:source.goal - (comment | string | meta.tag | meta.embedded)": {
      "patterns": [
        {
          "include": "#route"
        },
        {
          "include": "#server-function"
        }
      ]
    },
    "L:source.goal meta.embedded.expression.tsx - (comment | string)": {
      "patterns": [
        {
          "include": "#markup-if"
        },
        {
          "include": "#markup-else"
        }
      ]
    }
  },
  "repository": {
    "strict": {
      "comment": "#strict on the first line: the file's types are checked",
      "match": "\\A\\s*(#strict)(?=[ \\t]*$)",
      "captures": {
        "1": {
          "name": "keyword.control.directive.strict.goal"
        }
      }
    },
    "route": {
      "comment": "route GET /users/{id} {  or, in a #strict file, /users/{id: number}; the body that follows is an ordinary block",
      "match": "^\\s*(route)\\s+([A-Z]+)\\s+(/(?:\\{[^}\\n]*\\}|[^\\s{])*)(?=\\s*\\{)",
      "captures": {
        "1": {
          "name": "storage.type.route.goal"
        },
        "2": {
          "patterns": [
            {
              "match": "\\b(?:GET|POST|PUT|PATCH|DELETE)\\b",
              "name": "constant.language.http-method.goal"
            },
            {
              "match": ".+",
              "name": "invalid.illegal.http-method.goal"
            }
          ]
        },
        "3": {
          "name": "string.unquoted.route-path.goal",
          "patterns": [
            {
              "match": "(\\{)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?:(:)\\s*([^}\\s]*)\\s*)?(\\})",
              "captures": {
                "1": {
                  "name": "punctuation.definition.parameter.begin.goal"
                },
                "2": {
                  "name": "variable.parameter.route.goal"
                },
                "3": {
                  "name": "keyword.operator.type.annotation.goal"
                },
                "4": {
                  "patterns": [
                    {
                      "match": "(?<![\\w$])(?:string|number)(?![\\w$])",
                      "name": "support.type.primitive.goal"
                    },
                    {
                      "match": "[^}\\s]+",
                      "name": "invalid.illegal.route-parameter-type.goal"
                    }
                  ]
                },
                "5": {
                  "name": "punctuation.definition.parameter.end.goal"
                }
              }
            },
            {
              "match": "/",
              "name": "punctuation.separator.path.goal"
            }
          ]
        }
      }
    },
    "server-function": {
      "comment": "`server function name()` and `export server function name()`; the JSX grammar takes the function from `function` on",
      "match": "(?<![_$[:alnum:]]|\\.)(?:(export)\\s+)?(server)(?=[ \\t]+function\\b)",
      "captures": {
        "1": {
          "name": "keyword.control.export.goal"
        },
        "2": {
          "name": "storage.modifier.server.goal"
        }
      }
    },
    "markup-if": {
      "comment": "{if (cond) X ...}: X may be markup right after the condition, which the JSX grammar alone would read as `<`",
      "begin": "(?<![_$[:alnum:]]|\\.)(if)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.conditional.goal"
        }
      },
      "end": "(?=(?<![_$[:alnum:].])else\\b|[;}])",
      "patterns": [
        {
          "include": "#markup-value"
        }
      ]
    },
    "markup-else": {
      "begin": "(?<![_$[:alnum:]]|\\.)(else)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.conditional.goal"
        }
      },
      "end": "(?=(?<![_$[:alnum:].])else\\b|[;}])",
      "patterns": [
        {
          "include": "#markup-value"
        }
      ]
    },
    "markup-value": {
      "patterns": [
        {
          "include": "source.tsx#comment"
        },
        {
          "include": "source.tsx#jsx-tag-without-attributes"
        },
        {
          "include": "source.tsx#jsx-tag"
        },
        {
          "include": "source.tsx#control-statement"
        },
        {
          "include": "source.tsx#decl-block"
        },
        {
          "include": "source.tsx#expression"
        }
      ]
    }
  }
}
