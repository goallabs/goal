{
  "Route": {
    "prefix": "route",
    "description": "A route: runs on the server, once per request",
    "body": ["route ${1|GET,POST,PUT,PATCH,DELETE|} /${2:path} {", "\treturn $0;", "}"]
  },
  "Group": {
    "prefix": "group",
    "description": "A group: routes under one path, with a before block that runs first (api: for other programs)",
    "body": ["group /${1:path} {", "\tbefore {", "\t\t$2", "\t}", "", "\troute ${3|GET,POST,PUT,PATCH,DELETE|} /${4} {", "\t\treturn $0;", "\t}", "}"]
  },
  "Component": {
    "prefix": "component",
    "description": "A component: var is state, let/const are computed",
    "body": [
      "export function ${1:Name}(${2:{ ${3:start} \\}}) {",
      "\tvar ${4:count} = ${5:0};",
      "",
      "\treturn (",
      "\t\t<div>",
      "\t\t\t$0",
      "\t\t</div>",
      "\t);",
      "}"
    ]
  },
  "Server function": {
    "prefix": "server",
    "description": "A server function: components call it like a plain function, with no async and no fetch",
    "body": ["export server function ${1:name}(${2}) {", "\t$0", "}"]
  }
}
