{
  "name": "goaljs",
  "version": "0.5.0",
  "description": "goal.js: var is state, let/const are computed, server-rendered and resumable",
  "homepage": "https://goallabs.github.io/goal/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goallabs/goal.git"
  },
  "bugs": {
    "url": "https://github.com/goallabs/goal/issues"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "build:demo": "node bin/goal.js build examples/demo",
    "demo": "node bin/goal.js dev examples/demo",
    "bench:virtual": "node bench/virtual.mjs"
  },
  "keywords": [
    "framework",
    "compiler",
    "ssr",
    "resumable",
    "jsx",
    "server-functions"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "bin",
    "src"
  ],
  "dependencies": {
    "@babel/generator": "^8.1.3",
    "@babel/parser": "^8.1.3",
    "@babel/traverse": "^8.1.3",
    "@babel/types": "^8.1.3",
    "acorn": "^8.19.0",
    "acorn-jsx": "^5.3.2",
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.1",
    "happy-dom": "^21.0.4",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "bin": {
    "goal": "bin/goal.js"
  },
  "exports": {
    ".": "./src/server.js",
    "./compiler": "./src/compiler.js",
    "./rt": "./src/rt.js",
    "./loader": "./src/loader.js",
    "./build": "./src/build.js",
    "./keyed": "./src/keyed.js",
    "./vite": "./src/vite.js"
  }
}
