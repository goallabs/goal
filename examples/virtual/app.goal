import { VirtualList } from './components/VirtualList.goal';

route GET / {
  return (
    <html lang="en">
      <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>goal.js virtual list</title>
        <link rel="stylesheet" href="/style.css" />
      </head>
      <body>
        <h1>100,000 rows</h1>
        <VirtualList />
      </body>
    </html>
  );
}
